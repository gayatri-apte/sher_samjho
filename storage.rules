rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Recitations are uploaded by Cloud Functions; users may read their own.
    match /recitations/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
